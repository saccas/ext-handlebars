{
    "name": "visol/typo3-handlebars",
    "description": "This is a TYPO3 CMS extension to render native handlebars templates",
    "type": "typo3-cms-extension",
    "homepage": "https://www.visol.ch",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "Visol\\Handlebars\\": "Classes/"
        }
    },
    "require": {
        "php": ">= 8.2 < 8.5",
        "zordius/lightncandy": "^1.2",
        "typo3/cms-core": "^13.4",
        "typo3/cms-extbase": "^13.4",
        "typo3fluid/fluid": "^4.0"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.0",
        "symplify/easy-coding-standard": "^12.3",
        "phpstan/extension-installer": "^1.4",
        "saschaegerer/phpstan-typo3": "^1.10"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "handlebars",
            "web-dir": ".Build/web"
        }
    },
    "config": {
        "lock": false,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "phpstan/extension-installer": true
        }
    }
}
